NODE_ENV=development
PORT=3000

DATABASE_HOST=100.126.184.124
DATABASE_PORT=5434
DATABASE_NAME=coloc_dev_db
DATABASE_USER=coloc_admin
# Quote values containing # (otherwise the rest is read as a comment)
DATABASE_PASSWORD='Ediiz_37#&'
# Auto-create tables from entities. Dev only — use migrations in production.
DB_SYNCHRONIZE=true


REDIS_HOST=100.126.184.124
REDIS_PORT=6300
REDIS_PASSWORD=

# At least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-min
JWT_EXPIRES_IN=7d

# Outgoing mail (confirmation codes). Mailpit from docker-compose.yml: inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=coloc <no-reply@coloc.local>

# Uploaded images (chores, event photos)
UPLOAD_DIR=./uploads

# Frontend URL, invite links look like ${APP_URL}/join/<token>
APP_URL=http://localhost:5173
